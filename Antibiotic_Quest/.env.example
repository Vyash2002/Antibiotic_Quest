# Copy this file to .env and fill in the values.

# Password for the /admin page. Change it before the pilot.
ADMIN_TOKEN=change-me

# Optional: Google Gemini API key for the AI question-drafting module (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model name. "gemini-flash-latest" always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional: put the database somewhere else
# AQ_DATABASE=db/antibiotic_quest.db
